//-views/home.pug
extends layout

block styles
  link(rel='stylesheet' href='/css/home.css')

block content
  section.hero
    .hero-inner
      .hero-eyebrow ✦ &nbsp;Practice Exams
      h1.hero-title
        | Study smarter,
        br
        span.hero-accent not harder.
      p.hero-subtitle
        | Scenario-based multiple-choice quizzes that test true understanding —
        | not memorisation. Pick a subject and start practising.
      .hero-stats
        .hero-stat
          span.stat-num 8+
          span.stat-label Subjects
        .hero-divider
        .hero-stat
          span.stat-num 250+
          span.stat-label Questions
        .hero-divider
        .hero-stat
          span.stat-num Weekly
          span.stat-label Updates
    .hero-banner
      img.hero-image(src='/img/1-home-hero-illustration.png' alt='Hero Illustration')

          

  //- ── All Subjects Section
  section.subjects-section
    .subjects-container
      //- Loop through subjects array
      each subject in subjects
        .subject-card( data-subject-name=subject.name)
          .subject-card-header
            span.subject-badge
              span.badge-dot(class=`badge-dot--${subject.name}`)
              | #{subject.name}
          h2.subject-card-title #{subject.title}
          p.subject-card-desc #{subject.description}
          span.subject-card-cta All #{subject.name} quizzes →
