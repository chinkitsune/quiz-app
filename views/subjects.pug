//- views/subjects.pug
extends layout 

block styles
  link(rel='stylesheet' href='/css/subjects.css')


block content
  section.subject-hero
    .subject-hero-inner
      .subject-icon= subject.icon
      h1.subject-title= subject.title
      p.subject-lead= subject.fullDescription
  
  section.quiz-list
    h2 Available Quizzes
    .quiz-cards
      each quiz in quizzes
        .quiz-card
          h3= quiz.title
          p= quiz.description
          a.btn(href=`/quizzes/${quiz.slug}`) Start Quiz


