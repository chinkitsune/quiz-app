doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title QuizLab — Practice Smarter
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(href='https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap' rel='stylesheet')
    link(rel='stylesheet' href='/css/index.css')

  body

    //- ── Navigation Bar ────────────────────────────────────────────────────
    header.navbar
      nav.nav-inner
        //- Logo
        a.nav-logo(href='/')
          span.nav-logo-icon ⬡
          span.nav-logo-text Quiz
          span.nav-logo-accent Lab

        //- Desktop nav links
        ul.nav-links
          li: a.nav-link.active(href='/') Home
          li: a.nav-link(href='#java') Java
          li: a.nav-link(href='#web') Web
          li: a.nav-link(href='#linux') Linux
          li: a.nav-link(href='#database') Database

        //- Right-side controls
        .nav-actions
          button.nav-search-btn(aria-label='Search quizzes')
            svg(xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
              circle(cx='11' cy='11' r='8')
              line(x1='21' y1='21' x2='16.65' y2='16.65')
          button.hamburger(id='hamburger' aria-label='Open menu' aria-expanded='false')
            span
            span
            span

      //- Mobile drawer
      .mobile-drawer(id='mobile-drawer' aria-hidden='true')
        ul.mobile-nav-links
          li: a.mobile-nav-link(href='/') Home
          li: a.mobile-nav-link(href='#java') Java
          li: a.mobile-nav-link(href='#web') Web Programming
          li: a.mobile-nav-link(href='#linux') Linux
          li: a.mobile-nav-link(href='#database') Database

    //- ── Search Overlay ────────────────────────────────────────────────────
    .search-overlay(id='search-overlay' aria-hidden='true')
      .search-modal
        .search-input-wrap
          svg.search-icon(xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
            circle(cx='11' cy='11' r='8')
            line(x1='21' y1='21' x2='16.65' y2='16.65')
          input#search-input(type='text' placeholder='Search quizzes…' autocomplete='off' spellcheck='false')
          button.search-close(id='search-close' aria-label='Close search') ✕
        ul.search-results(id='search-results')
        p.search-empty(id='search-empty') Type to search across all quizzes

    //- ── Main Content ───────────────────────────────────────────────────────
    main.main-content

      //- ── Hero ─────────────────────────────────────────────────────────────
      section.hero
        .hero-inner
          .hero-eyebrow ✦ &nbsp;Practice Exams
          h1.hero-title
            | Study smarter,
            br
            span.hero-accent not harder.
          p.hero-subtitle
            | Scenario-based multiple-choice quizzes that test true understanding —
            | not memorisation. Pick a subject and start practising.
          .hero-stats
            .hero-stat
              span.stat-num 5
              span.stat-label Subjects
            .hero-divider
            .hero-stat
              span.stat-num 250+
              span.stat-label Questions
            .hero-divider
            .hero-stat
              span.stat-num Weekly
              span.stat-label Updates

      //- ── Subject Sections ─────────────────────────────────────────────────

      //- ── Java ─────────────────────────────────────────────────────────────
      section#java.subject-section
        .section-header
          .section-header-left
            span.section-badge
              span.badge-dot(style='background:#2d5a3d')
              | Java
            h2.section-title Object-Oriented Programming
            p.section-desc CST8284 · Weekly practice exams covering OOP concepts in Java
          a.section-see-all(href='#java') All Java quizzes →

        .cards-grid

          +quizCard(
            '/quiz/java/week9',
            'Week 9',
            'Generics',
            'Type parameters, generic classes & methods, bounds, wildcards, and type erasure.',
            '57',
            'java',
            ['Type Parameters', 'Wildcards', 'Type Erasure'],
            false
          )

          +quizCard(
            '/quiz/java/week10',
            'Week 10',
            'Collections',
            'ArrayList, LinkedList, Sets, Maps, Queues, iterators, sorting, and choosing the right collection.',
            '57',
            'java',
            ['List', 'Set', 'Map', 'Queue'],
            false
          )

          +quizCard(
            '/quiz/java/week11',
            'Week 11',
            'Swing GUI',
            'Layouts, text & choice components, event handling, menus, and UI design patterns.',
            '55',
            'java',
            ['JFrame', 'Layouts', 'Events'],
            false
          )

          +quizCard(
            '/quiz/java/week12',
            'Week 12',
            'Exception Handling',
            'try/catch/finally, checked vs unchecked, custom exceptions, stack unwinding, and chained exceptions.',
            '57',
            'java',
            ['try/catch', 'Custom', 'Erasure'],
            false
          )

          +quizCard(
            '/quiz/java/week13',
            'Week 13',
            'File I/O & NIO',
            'Streams, NIO classes, sequential text files, Scanner, Formatter, and persistent data.',
            '57',
            'java',
            ['NIO', 'Streams', 'Formatter'],
            false
          )

      //- ── Web Programming ──────────────────────────────────────────────────
      section#web.subject-section
        .section-header
          .section-header-left
            span.section-badge
              span.badge-dot(style='background:#1a5fa8')
              | Web
            h2.section-title Web Programming
            p.section-desc HTML, CSS, JavaScript, and modern front-end frameworks
          a.section-see-all(href='#web') All Web quizzes →

        .cards-grid

          +quizCard(
            '#',
            'Week 1',
            'HTML Fundamentals',
            'Semantic elements, forms, accessibility, and document structure.',
            '50',
            'web',
            ['Semantic', 'Forms', 'A11y'],
            true
          )

          +quizCard(
            '#',
            'Week 2',
            'CSS & Layout',
            'Box model, Flexbox, Grid, responsive design, and custom properties.',
            '55',
            'web',
            ['Flexbox', 'Grid', 'RWD'],
            true
          )

          +quizCard(
            '#',
            'Week 3',
            'JavaScript Core',
            'Scope, closures, promises, async/await, and the event loop.',
            '60',
            'web',
            ['Closures', 'Async', 'DOM'],
            true
          )

      //- ── Linux ────────────────────────────────────────────────────────────
      section#linux.subject-section
        .section-header
          .section-header-left
            span.section-badge
              span.badge-dot(style='background:#b45309')
              | Linux
            h2.section-title Linux & Shell
            p.section-desc Command line, scripting, permissions, and system administration
          a.section-see-all(href='#linux') All Linux quizzes →

        .cards-grid

          +quizCard(
            '#',
            'Week 1',
            'CLI Basics',
            'Navigating the filesystem, pipes, redirection, and essential commands.',
            '50',
            'linux',
            ['Commands', 'Pipes', 'I/O'],
            true
          )

          +quizCard(
            '#',
            'Week 2',
            'Permissions & Users',
            'File permissions, ownership, sudo, groups, and user management.',
            '45',
            'linux',
            ['chmod', 'Users', 'sudo'],
            true
          )

          +quizCard(
            '#',
            'Week 3',
            'Shell Scripting',
            'Variables, control flow, functions, and automating tasks with Bash.',
            '55',
            'linux',
            ['Bash', 'Loops', 'Functions'],
            true
          )

      //- ── Database ─────────────────────────────────────────────────────────
      section#database.subject-section
        .section-header
          .section-header-left
            span.section-badge
              span.badge-dot(style='background:#7c3aed')
              | Database
            h2.section-title Database & SQL
            p.section-desc Relational design, SQL queries, normalization, and transactions
          a.section-see-all(href='#database') All Database quizzes →

        .cards-grid

          +quizCard(
            '#',
            'Week 1',
            'SQL Foundations',
            'SELECT, WHERE, JOIN, GROUP BY, and aggregate functions.',
            '55',
            'database',
            ['SELECT', 'JOIN', 'GROUP BY'],
            true
          )

          +quizCard(
            '#',
            'Week 2',
            'Normalization',
            '1NF, 2NF, 3NF, functional dependencies, and schema design.',
            '50',
            'database',
            ['1NF', '2NF', '3NF'],
            true
          )

          +quizCard(
            '#',
            'Week 3',
            'Transactions & Indexes',
            'ACID properties, isolation levels, indexing strategies, and query optimisation.',
            '50',
            'database',
            ['ACID', 'Indexes', 'Tuning'],
            true
          )

    //- ── Footer ─────────────────────────────────────────────────────────────
    footer.site-footer
      .footer-inner
        .footer-brand
          span.footer-logo-icon ⬡
          span.footer-logo-text QuizLab
          p.footer-tagline Helping students build real understanding, one question at a time.

        nav.footer-nav
          .footer-nav-group
            h4.footer-nav-title Subjects
            ul
              li: a(href='#java') Java OOP
              li: a(href='#web') Web Programming
              li: a(href='#linux') Linux & Shell
              li: a(href='#database') Database & SQL

          .footer-nav-group
            h4.footer-nav-title Resources
            ul
              li: a(href='#') How it works
              li: a(href='#') Question format
              li: a(href='#') Progress tracking

        .footer-bottom
          p © 2025 QuizLab · CST8284 Study Companion
          p.footer-note Built for students, by students.

    //- ── Back to Top ─────────────────────────────────────────────────────────
    button.back-to-top(id='back-to-top' aria-label='Back to top')
      svg(xmlns='http://www.w3.org/2000/svg' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round')
        polyline(points='18 15 12 9 6 15')

    script(src='/js/index.js')

  //- ── Mixin: Quiz Card ──────────────────────────────────────────────────────
  //- Usage: +quizCard(href, week, title, desc, qCount, subject, tags, comingSoon)
  mixin quizCard(href, week, title, desc, qCount, subject, tags, comingSoon)
    a.quiz-card(
      href=comingSoon ? null : href
      class=comingSoon ? 'quiz-card--soon' : ''
      data-subject=subject
      data-title=title
      data-week=week
      aria-disabled=comingSoon ? 'true' : 'false'
    )
      .card-top
        .card-week-badge= week
        if comingSoon
          span.card-soon-badge Coming Soon
        else
          span.card-q-count= qCount + ' Qs'

      h3.card-title= title
      p.card-desc= desc

      .card-tags
        each tag in tags
          span.card-tag= tag

      .card-footer
        if comingSoon
          span.card-cta.card-cta--soon ✦ &nbsp;Not yet available
        else
          span.card-cta
            | Start quiz &nbsp;
            svg(xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round')
              line(x1='5' y1='12' x2='19' y2='12')
              polyline(points='12 5 19 12 12 19')
