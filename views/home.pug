//-views/home.pug
extends layout

block styles
  link(rel='stylesheet' href='/css/home.css')

block content
  section.hero
        .hero-inner
          .hero-eyebrow ✦ &nbsp;Practice Exams
          h1.hero-title
            | Study smarter,
            br
            span.hero-accent not harder.
          p.hero-subtitle
            | Scenario-based multiple-choice quizzes that test true understanding —
            | not memorisation. Pick a subject and start practising.
          .hero-stats
            .hero-stat
              span.stat-num 5
              span.stat-label Subjects
            .hero-divider
            .hero-stat
              span.stat-num 250+
              span.stat-label Questions
            .hero-divider
            .hero-stat
              span.stat-num Weekly
              span.stat-label Updates
  //- ── Subject Sections ─────────────────────────────────────────────────

  //- ── All Subjects Section
  section.subjects-section
    .subjects-container
      .subject-card(data-subject-id="java" data-subject-name="Java")
        .subject-card-header
          span.subject-badge
            span.badge-dot(style='background:#2d5a3d')
            | Java
        h2.subject-card-title Object-Oriented Programming
        p.subject-card-desc CST8284 · Weekly practice exams covering OOP concepts in Java
        span.subject-card-cta All Java quizzes →

      .subject-card(data-subject-id="web" data-subject-name="Web")
        .subject-card-header
          span.subject-badge
            span.badge-dot(style='background:#1a5fa8')
            | Web
        h2.subject-card-title Web Programming
        p.subject-card-desc HTML, CSS, JavaScript, and modern front-end frameworks
        span.subject-card-cta All Web quizzes →

      .subject-card(data-subject-id="linux" data-subject-name="Linux")
        .subject-card-header
          span.subject-badge
            span.badge-dot(style='background:#b45309')
            | Linux
        h2.subject-card-title Linux & Shell
        p.subject-card-desc Command line, scripting, permissions, and system administration
        span.subject-card-cta All Linux quizzes →

      .subject-card(data-subject-id="database" data-subject-name="Database")
        .subject-card-header
          span.subject-badge
            span.badge-dot(style='background:#7c3aed')
            | Database
        h2.subject-card-title Database & SQL
        p.subject-card-desc Relational design, SQL queries, normalization, and transactions
        span.subject-card-cta All Database quizzes →
